{
  "name": "fernwick-reserve",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && rsbuild build",
    "start": "node dist-server/server/index.js",
    "test": "tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.3.3",
    "@rsbuild/plugin-react": "^2.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
